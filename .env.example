# Google Apps Script Webhook URL for Type Drift
NEXT_PUBLIC_GAS_WEBHOOK_URL=

# Keep Render as primary; Cloudflare Worker URL is used only if Render fails.
NEXT_PUBLIC_API_URL=https://type-drift-api.onrender.com
NEXT_PUBLIC_FALLBACK_API_URL=

# Server-only AI credentials. Never add the API key to a NEXT_PUBLIC_* variable.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

